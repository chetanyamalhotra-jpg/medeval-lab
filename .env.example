# Example environment file: placeholder NAMES only, no values and no provider.
#
# Copy this file to `.env` (git-ignored) only if you want the optional
# environment-variable path. The recommended bring-your-own-key paths are:
#
#   1. the app   : `medeval ui` -> Models page -> add a connection, paste the key
#                  (it stays in the app's process memory, never on disk);
#   2. the CLI   : copy `connections.example.yaml` to `connections.yaml` and name
#                  an environment variable per key (`key_env: MY_PROVIDER_KEY`).
#
# Loading `.env` is OFF by default in the app (`medeval ui --use-env` opts in).
# Any variable below can also be set directly in your shell instead.
#
# Whatever you choose, the maintainers never see your key and cannot stop or
# refund your usage: set a spend limit in your provider's dashboard too.

# --- one OpenAI-compatible endpoint -----------------------------------------
# Works with any provider that serves /chat/completions (OpenAI, Azure OpenAI,
# OpenRouter, vLLM, LM Studio, Ollama, DeepSeek, ...). There is no default: an
# empty value means "no endpoint configured".
MEDEVAL_BASE_URL=
MEDEVAL_MODEL=
MEDEVAL_API_KEY=

# --- optional generation and retry settings (defaults shown) ----------------
MEDEVAL_BACKEND=auto
MEDEVAL_TEMPERATURE=0.0
MEDEVAL_MAX_TOKENS=2048
MEDEVAL_SEED=20260101
MEDEVAL_TIMEOUT_S=60
MEDEVAL_RETRIES=2
MEDEVAL_RETRY_ATTEMPTS=4

# --- hard paid-call safeguards (the call cap works with no prices set) -----
MEDEVAL_MAX_CALLS=1500
MEDEVAL_MAX_USD=5

# --- prices: copy them from your provider's pricing page -------------------
# Values are USD per 1,000,000 tokens. Leave all of them empty and the estimate
# says "unavailable, call cap is binding" instead of guessing.
MEDEVAL_INPUT_USD_PER_1M=
MEDEVAL_OUTPUT_USD_PER_1M=
MEDEVAL_REASONING_USD_PER_1M=
MEDEVAL_PRICE_SOURCE=
MEDEVAL_PRICE_SOURCE_URL=
MEDEVAL_PRICE_DATE=

# --- optional small CPU model for the local-HF backend ---------------------
# Needs torch + transformers installed; no key and no network after the weights
# are downloaded once.
MEDEVAL_HF_MODEL=
