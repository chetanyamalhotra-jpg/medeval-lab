# Secrets -- never commit
.env
.env.*
!.env.example
*.key
secrets/
.private/

# Connection metadata: names, base URLs, models, caps. API keys are NEVER in
# this file (they live only in the app's process memory), but the file is still
# local configuration rather than project content.
data/connections.json
data/paper_notes.json
data/workspaces.json
results/exports/
data/preferences.json
data/review_notes.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling / caches
.medeval_cache/
.medeval_data/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tmp/

# Downloaded dataset snapshots and HF caches (regenerated by the audit pipeline;
# sizes and content fingerprints are recorded in results/audit/datasets.csv)
data/cache/
hf/
.hfhub/
.cache/

# Local runtime artefacts that must not be mistaken for evidence.
# The call log holds full prompt text (~16 MB for Experiment 001) and is fully
# regenerable from seeds and template versions; verdicts.jsonl (with prompt
# hashes) IS committed.
results/**/calls.jsonl
results/calls/
results/matrix_runs/
results/harness_runs/samples_*.jsonl

# Benchmark text and model output stay out of version control: MedQA-USMLE is
# CC-BY-SA-4.0 and this repository does not redistribute it. Only ids, verdicts,
# confidences, hashes and aggregate metrics are committed.
results/study_runs/*/items.jsonl
results/study_runs/*/candidates.jsonl
results/study_runs/*/cache.json
results/study_runs/*/calls.jsonl
results/study_runs/*/screening_cache.json

# One-off local maintenance scripts (never committed; they may hold local paths).
scripts/_*.py

# OS noise
Thumbs.db
desktop.ini
.DS_Store

pytest-of-*/
results/study_runs/exp002-20*/
results/study_runs/exp003-20*/

# v0.5 brought-your-own-key headless configuration. The file names the
# environment variable that holds each key (key_env: MY_PROVIDER_KEY); it never
# contains a key, but it is local configuration, so only the example is tracked.
connections.yaml
connections.local.yaml
*.local.yaml
connections.*.yaml
!connections.example.yaml

# Personal strings that must never be committed: the release audit
# (scripts/oss_audit.py) reads this file and fails if any of its lines appear in
# tracked content. Keep it here rather than in the tracked allow-list.
.private/

# Local reviewer notes and exports (one reviewer's opinion; may quote item text).
results/**/review_notes*.json
results/**/notes.local.*
results/exports/
*.bundle.zip

# Local release/verification reports
medeval-lab-v*-report.txt

